{
    "compilerOptions": {
        "target": "ES6",
        "module": "ES6",
        "outDir": "dist",
        "rootDir": "src",
        "baseUrl": "./src",
        "paths": {
            "@/*": [
                "*"
            ]
        },
        "strict": true,
        "esModuleInterop": true,
        "moduleResolution": "node",
        "resolveJsonModule": true,
        "allowImportingTsExtensions": true,
        "types": [
            "node",
            "vitest",
        ]
    },
    "include": [
        "src"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}
